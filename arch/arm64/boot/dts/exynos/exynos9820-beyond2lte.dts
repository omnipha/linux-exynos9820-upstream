/dts-v1/;
#include "exynos9820-common.dtsi"
#include <dt-bindings/interrupt-controller/irq.h>

/ {
	model = "Samsung Galaxy S10+ (SM-G975F)";
	compatible = "samsung,beyond2lte", "samsung,exynos9820";
	chassis-type = "handset";

	chosen {
		framebuffer0: framebuffer@ca000000 {
			compatible = "simple-framebuffer";
			reg = <0x0 0xca000000 (1440 * 3040 * 4)>;
			width = <1440>;
			height = <3040>;
			stride = <(1440 * 4)>;
			format = "a8r8g8b8";
			panel = <&panel>;

			/* Dummy panel for simple-framebuffer dimension info */
			panel: dummy-panel {
				width-mm = <70>;
				height-mm = <147>;
			};
		};
	};

	reserved-memory {
		/*
		 * Persistent crash log. 0xfd910000 is the stock log_kernel region
		 * (debug_snapshot); it does not overlap modem_if or cp_ram_logging
		 * (end 0xfd8fffff). Read after a crash from /sys/fs/pstore.
		 */
		ramoops@fd910000 {
			compatible = "ramoops";
			reg = <0x0 0xfd910000 0x200000>;
			record-size = <0x40000>;
			console-size = <0x40000>;
			pmsg-size = <0x40000>;
		};
	};

	wlan_pwr: regulator-wlan {
		compatible = "regulator-fixed";
		regulator-name = "wlan_reg_on";
		gpio = <&gpg0 5 GPIO_ACTIVE_HIGH>;
		enable-active-high;
		startup-delay-us = <200000>;
		pinctrl-names = "default";
		pinctrl-0 = <&wlan_en>;
	};
};

&battery {
	compatible = "simple-battery";
	constant-charge-current-max-microamp = <2850000>;
	charge-full-design-microamp-hours = <4000000>;
};

&gpu {
	status = "okay";
};

&usbdrd_dwc3 {
	dr_mode = "peripheral";
	maximum-speed = "high-speed";
};

&pcie_wifi {
	pinctrl-names = "default";
	pinctrl-0 = <&pcie0_clkreq &pcie0_perst>;
	reset-gpios = <&gpf2 2 GPIO_ACTIVE_LOW>;
	vpcie-supply = <&wlan_pwr>;
	status = "okay";
};

&pinctrl_fsys1 {
	pcie0_clkreq: pcie0-clkreq-pins {
		samsung,pins = "gpf2-0";
		samsung,pin-function = <EXYNOS_PIN_FUNC_2>;
		samsung,pin-pud = <EXYNOS_PIN_PULL_UP>;
		samsung,pin-drv = <3>;
	};

	pcie0_perst: pcie0-perst-pins {
		samsung,pins = "gpf2-2";
		samsung,pin-function = <EXYNOS_PIN_FUNC_OUTPUT>;
		samsung,pin-pud = <EXYNOS_PIN_PULL_NONE>;
		samsung,pin-drv = <3>;
	};
};

&usi_uart_bt {
	status = "okay";
};

&serial1 {
	pinctrl-names = "default";
	pinctrl-0 = <&uart1_bus>;
	uart-has-rtscts;
	status = "okay";

	bluetooth {
		compatible = "brcm,bcm4329-bt";
		pinctrl-names = "default";
		pinctrl-0 = <&bt_en &bt_wake &bt_hostwake>;
		shutdown-gpios = <&gpm8 0 GPIO_ACTIVE_HIGH>;
		device-wakeup-gpios = <&gpg2 0 GPIO_ACTIVE_HIGH>;
		interrupt-parent = <&gpa2>;
		interrupts = <3 IRQ_TYPE_EDGE_RISING>;
		interrupt-names = "host-wakeup";
	};
};

&pinctrl_alive {
	bt_hostwake: bt-hostwake-pins {
		samsung,pins = "gpa2-3";
		samsung,pin-function = <EXYNOS_PIN_FUNC_EINT>;
		samsung,pin-pud = <EXYNOS_PIN_PULL_DOWN>;
	};
};

&pinctrl_cmgp {
	bt_en: bt-en-pins {
		samsung,pins = "gpm8-0";
		samsung,pin-function = <EXYNOS_PIN_FUNC_OUTPUT>;
		samsung,pin-pud = <EXYNOS_PIN_PULL_NONE>;
	};
};

&pinctrl_peric0 {
	bt_wake: bt-wake-pins {
		samsung,pins = "gpg2-0";
		samsung,pin-function = <EXYNOS_PIN_FUNC_OUTPUT>;
		samsung,pin-pud = <EXYNOS_PIN_PULL_NONE>;
		samsung,pin-con-pdn = <EXYNOS_PIN_PDN_PREV>;
		samsung,pin-pud-pdn = <EXYNOS_PIN_PULL_NONE>;
	};

	wlan_en: wlan-en-pins {
		samsung,pins = "gpg0-5";
		samsung,pin-function = <EXYNOS_PIN_FUNC_OUTPUT>;
		samsung,pin-pud = <EXYNOS_PIN_PULL_NONE>;
		samsung,pin-drv = <3>;
	};
};
