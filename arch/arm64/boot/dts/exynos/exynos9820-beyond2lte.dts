/dts-v1/;
#include "exynos9820-common.dtsi"

/ {
	model = "Samsung Galaxy S10+ (SM-G975F)";
	compatible = "samsung,beyond2lte", "samsung,exynos9820";
	chassis-type = "handset";

	chosen {
		framebuffer0: framebuffer@ca000000 {
			compatible = "simple-framebuffer";
			reg = <0x0 0xca000000 (1440 * 3040 * 4)>;
			width = <1440>;
			height = <3040>;
			stride = <(1440 * 4)>;
			format = "a8r8g8b8";
			panel = <&panel>;

			/* Dummy panel for simple-framebuffer dimension info */
			panel: dummy-panel {
				width-mm = <70>;
				height-mm = <147>;
			};
		};
	};

	wlan_pwr: regulator-wlan {
		compatible = "regulator-fixed";
		regulator-name = "wlan_reg_on";
		gpio = <&gpg0 5 GPIO_ACTIVE_HIGH>;
		enable-active-high;
		startup-delay-us = <200000>;
		pinctrl-names = "default";
		pinctrl-0 = <&wlan_en>;
	};
};

&battery {
	compatible = "simple-battery";
	constant-charge-current-max-microamp = <2850000>;
	charge-full-design-microamp-hours = <4000000>;
};

&usbdrd_dwc3 {
	dr_mode = "peripheral";
	maximum-speed = "high-speed";
};

&pcie_wifi {
	pinctrl-names = "default";
	pinctrl-0 = <&pcie0_clkreq &pcie0_perst>;
	reset-gpios = <&gpf2 2 GPIO_ACTIVE_LOW>;
	vpcie-supply = <&wlan_pwr>;
	status = "okay";
};

&pinctrl_fsys1 {
	pcie0_clkreq: pcie0-clkreq-pins {
		samsung,pins = "gpf2-0";
		samsung,pin-function = <EXYNOS_PIN_FUNC_2>;
		samsung,pin-pud = <EXYNOS_PIN_PULL_UP>;
		samsung,pin-drv = <3>;
	};

	pcie0_perst: pcie0-perst-pins {
		samsung,pins = "gpf2-2";
		samsung,pin-function = <EXYNOS_PIN_FUNC_OUTPUT>;
		samsung,pin-pud = <EXYNOS_PIN_PULL_NONE>;
		samsung,pin-drv = <3>;
	};
};

&pinctrl_peric0 {
	wlan_en: wlan-en-pins {
		samsung,pins = "gpg0-5";
		samsung,pin-function = <EXYNOS_PIN_FUNC_OUTPUT>;
		samsung,pin-pud = <EXYNOS_PIN_PULL_NONE>;
		samsung,pin-drv = <3>;
	};
};
